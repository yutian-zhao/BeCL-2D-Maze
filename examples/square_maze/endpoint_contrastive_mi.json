    "device": "cpu",
    "mode": "strict",
    "skill_update_freq": 5,
    "aux_rollouts": 2500,
    "skill_n": 15,
    "gamma": 0.99,
    "gae_lambda": 0.98,
    "entropy_lambda": 0.025,
    "normalize_inputs": false,
    "env_reward": false,
    "rollouts": 500,
    "n_mini_batches": 10,
    "hidden_size": 128,
    "num_layers": 3,
    "im_params": {
      "nu": 1,
      "lambda": 1,
      "model_params": {
        "traj_length_each_episode": 5,
        "temperature": 0.5
      }
    }
  }
