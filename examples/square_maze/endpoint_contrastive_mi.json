{
  "learner_type": "EndpointContrastiveMI",
  "agent_type": "maze",
  "train_type": "ppo",
  "seed": 3,
  "use_wandb": true,
  "use_tb": false,
  "norm_advantage": true,
  "cycles_per_epoch": 50,
  "rollouts_per_cycle": 1,
  "update_epochs_per_rollout": 4,
  "eval_iters": 20,
  "greedy_eval": false,
  "learning_rate": 0.0003,
  "epoch_lr_decay": 1,
  "agent_params": {
    "env_params": {
      "n": 5,
      "maze_type": "square_empty",
      "done_on_success": false,
      "random_start": true
